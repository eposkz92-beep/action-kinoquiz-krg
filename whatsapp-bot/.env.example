# ==============================================================================
# ACTION Kinoquiz WhatsApp Bot - Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
LOG_LEVEL=info

# HTTP Server & Dual QR Presentation Portal
# Port for the web-based QR scanning interface (http://localhost:3000)
PORT=3000
QR_PORT=3000

# SQLite Database Storage
# Local database file path (created automatically if missing)
DB_PATH=./data/kinoquiz.db

# WhatsApp Session Storage
# Directory where Baileys stores multi-device auth credentials
AUTH_DIR=./auth_info_baileys

# CSV Export Directory
CSV_EXPORT_DIR=./exports

# Quiz Game Catalog Sources
INSTAGRAM_STATE_PATH=../instagram_state.json
INDEX_HTML_PATH=../index.html

# Timezone for Game Reminders and Timestamps
TIMEZONE=Asia/Almaty

# Telegram Organizer Alerts (Instant notifications upon new booking)
# 1. Create a bot with @BotFather to get the token
# 2. Add bot to organizers chat and get the chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets Sync (Optional: non-blocking export of bookings)
# Requires a Google Cloud Project with Google Sheets API enabled and a Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Брони

# Quiz Event Details & Defaults
QUIZ_LOCATION="Караоке-бар «То Место», г. Караганда, пр. Нуркена Абдирова, д. 5"
QUIZ_PRICE_PER_PLAYER=3000
ORGANIZER_PHONE="+7 701 186 31 90"
